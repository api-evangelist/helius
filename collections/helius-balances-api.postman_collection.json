      },
      "item": [
        {
          "id": "011a7d22-9db5-40b9-8e44-a9fd49a7df79",
          "name": "Get wallet balances",
          "request": {
            "name": "Get wallet balances",
            "description": {
              "content": "Retrieve token and NFT balances for a wallet. **Pagination is manual** - the API returns up to 100 tokens per request.\n\nResults are sorted by USD value in descending order. Tokens with pricing data appear first, followed by tokens without prices.\n\n**Pagination:** Use the `page` parameter to fetch additional pages. The response includes `pagination.hasMore`\nto indicate if more results are available. Each request makes a single API call and costs 100 credits.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v1",
                "wallet",
                ":wallet",
                "balances"
              ],
              "host": [
                "api",
                "helius",
                "xyz"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (1-indexed)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of tokens per page"
                },
                {
                  "disabled": false,
                  "key": "showZeroBalance",
                  "value": "false",
                  "description": "Include tokens with zero balance"
                },
                {
                  "disabled": false,
                  "key": "showNative",
                  "value": "true",
                  "description": "Include native SOL in results"
                },
                {
                  "disabled": false,
                  "key": "showNfts",
                  "value": "false",
                  "description": "Include NFTs in results (max 100, first page only)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "wallet",
                  "description": "(Required) Solana wallet address (base58 encoded)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
