      "item": [
        {
          "id": "abd7909d-8eb1-4497-9340-58f7430cac2c",
          "name": "Get wallet identity",
          "request": {
            "name": "Get wallet identity",
            "description": {
              "content": "Retrieve identity information for a known wallet (exchanges, protocols, etc.). Accepts\neither a Solana wallet address or an SNS (`.sol`) / ANS custom TLD domain name\n(e.g. `toly.sol`, `miester.bonk`). Domain resolution is mainnet-only.\n\nThe response is the standard identity object for the **resolved address**. No domain\nmarker (`inputDomain`) is attached on this endpoint — use `POST /v1/wallet/batch-identity`\nif you need to correlate inputs with outputs.\n\nReturns `404` if the wallet has no identity entry, or if a domain input cannot be resolved.\nReturns `400` if the input is neither a valid address nor a valid domain name, or if a\ndomain input is sent on a non-mainnet deployment.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v1",
                "wallet",
                ":wallet",
                "identity"
              ],
              "host": [
                "api",
                "helius",
                "xyz"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "wallet",
                  "description": "(Required) Solana wallet address (base58 encoded) or SNS/ANS domain name (e.g. `toly.sol`,\n`miester.bonk`). Domain resolution is mainnet-only. Any non-`.sol` domain is treated\nas an ANS custom TLD — there is no fixed TLD whitelist.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
